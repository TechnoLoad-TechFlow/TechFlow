@startuml
title TechFlow - Rental Management\nBig Picture Event Storming

left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial

' =========================
' Styles
' =========================

rectangle "COMMAND\nRequest Rental" as CMD_REQUEST #87CEFA
rectangle "AGGREGATE\nRental" as AGG_REQUEST #FFF59D
rectangle "ACTOR\nContractor" as ACT_REQUEST #FFF9C4
rectangle "COMMAND\nConfirm Reservation" as CMD_CONFIRM #87CEFA
rectangle "AGGREGATE\nRental" as AGG_CONFIRM #FFF59D
rectangle "ACTOR\nFleet Owner" as ACT_CONFIRM #FFF9C4
rectangle "COMMAND\nCancel Reservation" as CMD_CANCEL #87CEFA
rectangle "AGGREGATE\nRental" as AGG_CANCEL #FFF59D
rectangle "ACTOR\nContractor" as ACT_CANCEL #FFF9C4
rectangle "COMMAND\nUpdate Rental Dates" as CMD_UPDATE_DATES #87CEFA
rectangle "AGGREGATE\nRental" as AGG_UPDATE_DATES #FFF59D
rectangle "ACTOR\nContractor" as ACT_UPDATE_DATES #FFF9C4

rectangle "DOMAIN EVENT\nRental Requested" as EVT_REQUESTED #FFB74D
rectangle "DOMAIN EVENT\nReservation Confirmed" as EVT_CONFIRMED #FFB74D
rectangle "DOMAIN EVENT\nReservation Cancelled" as EVT_CANCELLED #FFB74D
rectangle "DOMAIN EVENT\nRental Dates Updated" as EVT_DATES_UPDATED #FFB74D

rectangle "READ MODEL\nRental Request List" as READ_REQUESTS #81C784
rectangle "QUERY\nView Rental Requests" as QUERY_REQUESTS #87CEFA
rectangle "QUERY RESULT\nRental Request List" as RESULT_REQUESTS #C8E6C9

rectangle "READ MODEL\nReservation List" as READ_RESERVATIONS #81C784
rectangle "QUERY\nView My Reservations" as QUERY_RESERVATIONS #87CEFA
rectangle "QUERY RESULT\nReservation List" as RESULT_RESERVATIONS #C8E6C9

rectangle "READ MODEL\nReservation Details" as READ_DETAILS #81C784
rectangle "QUERY\nCheck Reservation Details" as QUERY_DETAILS #87CEFA
rectangle "QUERY RESULT\nReservation Details" as RESULT_DETAILS #C8E6C9

' =========================
' Commands -> Aggregate -> Events
' =========================

CMD_REQUEST --> AGG_REQUEST --> EVT_REQUESTED
ACT_REQUEST -[hidden]up-> CMD_REQUEST

CMD_CONFIRM --> AGG_CONFIRM --> EVT_CONFIRMED
ACT_CONFIRM -[hidden]up-> CMD_CONFIRM

CMD_CANCEL --> AGG_CANCEL --> EVT_CANCELLED
ACT_CANCEL -[hidden]up-> CMD_CANCEL

CMD_UPDATE_DATES --> AGG_UPDATE_DATES --> EVT_DATES_UPDATED
ACT_UPDATE_DATES -[hidden]up-> CMD_UPDATE_DATES

' =========================
' Queries -> Read Models
' =========================

READ_REQUESTS --> QUERY_REQUESTS --> RESULT_REQUESTS
READ_RESERVATIONS --> QUERY_RESERVATIONS --> RESULT_RESERVATIONS
READ_DETAILS --> QUERY_DETAILS --> RESULT_DETAILS

legend right
|= Color |= Element |
|<#87CEFA>| Command / Query |
|<#FFF59D>| Aggregate |
|<#FFB74D>| Domain Event |
|<#FFF9C4>| Actor |
|<#81C784>| Read Model |
|<#C8E6C9>| Query Result |
endlegend

@enduml
